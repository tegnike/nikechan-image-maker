<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nikechan.thumbnail-studio</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/your-name/WorkSpace/nikechan-image-maker/scripts/serve-production.zsh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/your-name/WorkSpace/nikechan-image-maker</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/your-name/Library/Logs/nikechan-thumbnail-studio/output.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/your-name/Library/Logs/nikechan-thumbnail-studio/error.log</string>
</dict>
</plist>
